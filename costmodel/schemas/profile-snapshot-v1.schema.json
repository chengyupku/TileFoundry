{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilefoundry-costmodel/profile-snapshot-v1",
  "title": "TileFoundry cost-model profile snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "revision", "hardware", "measurements"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "hardware": {"$ref": "#/$defs/hardware"},
    "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}}
  },
  "$defs": {
    "hardwareRef": {
      "type": "object", "additionalProperties": false,
      "required": ["hardware_id", "schema_version", "calibration_id"],
      "properties": {"hardware_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "schema_version": {"const": 1}, "calibration_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "source", "conditions"],
      "properties": {"origin": {"enum": ["vendor", "measured", "derived", "conservative"]}, "source": {"type": "string", "minLength": 1}, "conditions": {"type": "string", "minLength": 1}}
    },
    "temporalResource": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "capacity_slots", "description", "provenance"],
      "properties": {"resource_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "capacity_slots": {"type": "integer", "minimum": 1}, "description": {"type": "string", "minLength": 1}, "provenance": {"$ref": "#/$defs/provenance"}}
    },
    "staticResource": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "capacity_units", "unit", "description", "provenance"],
      "properties": {"resource_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "capacity_units": {"type": "integer", "minimum": 1}, "unit": {"enum": ["bytes", "registers_32bit", "warps", "slots"]}, "description": {"type": "string", "minLength": 1}, "provenance": {"$ref": "#/$defs/provenance"}}
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "ref", "architecture", "temporal_resources", "static_resources", "supported_dtypes", "supported_implementation_ids"],
      "properties": {
        "schema_version": {"const": 1}, "ref": {"$ref": "#/$defs/hardwareRef"}, "architecture": {"type": "string", "minLength": 1},
        "temporal_resources": {"type": "array", "items": {"$ref": "#/$defs/temporalResource"}}, "static_resources": {"type": "array", "items": {"$ref": "#/$defs/staticResource"}},
        "supported_dtypes": {"type": "array", "uniqueItems": true, "items": {"enum": ["bf16", "fp16", "fp32", "fp8_e4m3", "fp8_e5m2"]}}, "supported_implementation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}
      }
    },
    "attribute": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "value": {"type": "string"}}
    },
    "axis": {"type": "object", "additionalProperties": false, "required": ["name", "extent"], "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "extent": {"type": "integer", "minimum": 1}}},
    "shape": {"type": "object", "additionalProperties": false, "required": ["axes"], "properties": {"axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}}}},
    "tensor": {"type": "object", "additionalProperties": false, "required": ["shape", "dtype", "layout"], "properties": {"shape": {"$ref": "#/$defs/shape"}, "dtype": {"enum": ["bf16", "fp16", "fp32", "fp8_e4m3", "fp8_e5m2"]}, "layout": {"enum": ["row_major", "column_major"]}, "strides_elements": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}}}},
    "valueType": {"type": "object", "additionalProperties": false, "required": ["tensor", "memory_space"], "properties": {"tensor": {"$ref": "#/$defs/tensor"}, "memory_space": {"enum": ["global", "shared", "tensor", "register"]}}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_kind", "operands", "results", "semantic_attributes"],
      "properties": {"op_kind": {"enum": ["copy", "gemm", "reduce", "elementwise"]}, "operands": {"type": "array", "items": {"$ref": "#/$defs/valueType"}}, "results": {"type": "array", "items": {"$ref": "#/$defs/valueType"}}, "semantic_attributes": {"type": "array", "items": {"$ref": "#/$defs/attribute"}}}
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["hardware", "operation", "implementation_id", "component_id", "tile_shape", "warp_config_id", "pipeline_depth", "layout_variant_id", "conditions"],
      "properties": {"hardware": {"$ref": "#/$defs/hardwareRef"}, "operation": {"$ref": "#/$defs/operation"}, "implementation_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "component_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "tile_shape": {"$ref": "#/$defs/shape"}, "warp_config_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "pipeline_depth": {"type": "integer", "minimum": 1}, "layout_variant_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "conditions": {"type": "array", "items": {"$ref": "#/$defs/attribute"}}}
    },
    "fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "provider_version", "benchmark_abi_version", "source_sha256", "compile_options_sha256"],
      "properties": {"provider_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "provider_version": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "benchmark_abi_version": {"type": "integer", "minimum": 1}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "compile_options_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "query", "fingerprint"],
      "properties": {"schema_version": {"const": 1}, "query": {"$ref": "#/$defs/query"}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_id", "device_uuid", "hardware", "cuda_arch", "driver_version", "runtime_version", "nvrtc_version", "device_clock_khz", "memory_clock_khz", "power_limit_mw"],
      "properties": {"environment_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "device_uuid": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "hardware": {"$ref": "#/$defs/hardwareRef"}, "cuda_arch": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "driver_version": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "runtime_version": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "nvrtc_version": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "device_clock_khz": {"type": ["integer", "null"], "exclusiveMinimum": 0}, "memory_clock_khz": {"type": ["integer", "null"], "exclusiveMinimum": 0}, "power_limit_mw": {"type": ["integer", "null"], "exclusiveMinimum": 0}}
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement_id", "key", "environment", "origin", "latency_p50_ps", "latency_p90_ps", "initiation_interval_p50_ps", "initiation_interval_p90_ps", "warmup_runs", "sample_count", "latency_repetitions_per_sample", "initiation_interval_repetitions_per_sample", "target_sample_ns", "relative_iqr_ppm", "raw_samples_retained", "raw_latency_samples_ps", "raw_initiation_interval_samples_ps", "measured_at_utc"],
      "properties": {
        "measurement_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"},
        "key": {"$ref": "#/$defs/key"},
        "environment": {"$ref": "#/$defs/environment"},
        "origin": {"const": "measured"},
        "latency_p50_ps": {"type": "integer", "minimum": 1},
        "latency_p90_ps": {"type": "integer", "minimum": 1},
        "initiation_interval_p50_ps": {"type": ["integer", "null"], "exclusiveMinimum": 0},
        "initiation_interval_p90_ps": {"type": ["integer", "null"], "exclusiveMinimum": 0},
        "warmup_runs": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1},
        "latency_repetitions_per_sample": {"type": "integer", "minimum": 1},
        "initiation_interval_repetitions_per_sample": {"type": ["integer", "null"], "exclusiveMinimum": 0},
        "target_sample_ns": {"type": "integer", "minimum": 1},
        "relative_iqr_ppm": {"type": "integer", "minimum": 0},
        "raw_samples_retained": {"type": "boolean"},
        "raw_latency_samples_ps": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "raw_initiation_interval_samples_ps": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "measured_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      },
      "allOf": [
        {
          "if": {"properties": {"initiation_interval_p50_ps": {"type": "null"}}},
          "then": {
            "properties": {
              "initiation_interval_p90_ps": {"type": "null"},
              "initiation_interval_repetitions_per_sample": {"type": "null"},
              "raw_initiation_interval_samples_ps": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "initiation_interval_p90_ps": {"type": "integer", "minimum": 1},
              "initiation_interval_repetitions_per_sample": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "if": {"properties": {"raw_samples_retained": {"const": false}}},
          "then": {
            "properties": {
              "raw_latency_samples_ps": {"maxItems": 0},
              "raw_initiation_interval_samples_ps": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {"raw_latency_samples_ps": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {
              "raw_samples_retained": {"const": true},
              "initiation_interval_p50_ps": {"type": "integer"}
            }
          },
          "then": {
            "properties": {"raw_initiation_interval_samples_ps": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
