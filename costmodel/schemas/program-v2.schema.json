{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilefoundry-costmodel/program-v2",
  "title": "TileFoundry cost-model program v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "workload_kind", "tile", "values", "loops", "operations", "dependencies", "loop_barriers", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": 2},
    "program_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"},
    "workload_kind": {"enum": ["gemm", "gqa_decode", "flash_attention", "mlp"]},
    "tile": {"$ref": "#/$defs/tile"},
    "values": {"type": "array", "items": {"$ref": "#/$defs/value"}},
    "loops": {"type": "array", "items": {"$ref": "#/$defs/loop"}},
    "operations": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/copy"}, {"$ref": "#/$defs/gemm"}, {"$ref": "#/$defs/reduce"}, {"$ref": "#/$defs/elementwise"}]}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "loop_barriers": {"type": "array", "items": {"$ref": "#/$defs/barrier"}},
    "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}},
    "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}
  },
  "$defs": {
    "axis": {"type": "object", "additionalProperties": false, "required": ["name", "extent"], "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "extent": {"type": "integer", "minimum": 1}}},
    "shape": {"type": "object", "additionalProperties": false, "required": ["axes"], "properties": {"axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}}}},
    "tensor": {"type": "object", "additionalProperties": false, "required": ["shape", "dtype", "layout"], "properties": {"shape": {"$ref": "#/$defs/shape"}, "dtype": {"enum": ["bf16", "fp16", "fp32", "fp8_e4m3", "fp8_e5m2"]}, "layout": {"enum": ["row_major", "column_major"]}, "strides_elements": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}}}},
    "valueType": {"type": "object", "additionalProperties": false, "required": ["tensor", "memory_space"], "properties": {"tensor": {"$ref": "#/$defs/tensor"}, "memory_space": {"enum": ["global", "shared", "tensor", "register"]}}},
    "value": {"type": "object", "additionalProperties": false, "required": ["value_id", "value_type"], "properties": {"value_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "value_type": {"$ref": "#/$defs/valueType"}}},
    "tile": {"type": "object", "additionalProperties": false, "required": ["tile_id", "shape"], "properties": {"tile_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "shape": {"$ref": "#/$defs/shape"}}},
    "loop": {"type": "object", "additionalProperties": false, "required": ["loop_id", "iterations"], "properties": {"loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "iterations": {"type": "integer", "minimum": 1}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["loop_id", "first_iteration", "iteration_count"], "properties": {"loop_id": {"type": ["string", "null"], "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "first_iteration": {"type": "integer", "minimum": 0}, "iteration_count": {"type": "integer", "minimum": 1}}},
    "copy": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "source", "destination", "domain"], "properties": {"kind": {"const": "copy"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "source": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "destination": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "domain": {"$ref": "#/$defs/domain"}}},
    "gemm": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "lhs", "rhs", "accumulator", "result", "m_axis", "n_axis", "k_axis", "domain"], "properties": {"kind": {"const": "gemm"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "lhs": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "rhs": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "accumulator": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "result": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "m_axis": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "n_axis": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "k_axis": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "domain": {"$ref": "#/$defs/domain"}}},
    "reduce": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "source", "result", "axes", "reduction", "domain"], "properties": {"kind": {"const": "reduce"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "source": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "result": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}, "reduction": {"enum": ["sum", "max"]}, "domain": {"$ref": "#/$defs/domain"}}},
    "elementwise": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "inputs", "result", "function", "domain"], "properties": {"kind": {"const": "elementwise"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}, "result": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "function": {"enum": ["add", "multiply", "divide", "exp", "relu", "gelu", "silu", "causal_mask"]}, "domain": {"$ref": "#/$defs/domain"}}},
    "aligned": {"type": "object", "additionalProperties": false, "required": ["kind", "iteration_distance"], "properties": {"kind": {"const": "aligned"}, "iteration_distance": {"type": "integer", "minimum": 0}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["kind", "src_endpoint", "dst_endpoint"], "properties": {"kind": {"const": "endpoint"}, "src_endpoint": {"enum": ["first", "last"]}, "dst_endpoint": {"enum": ["first", "last"]}}},
    "relation": {"oneOf": [{"$ref": "#/$defs/aligned"}, {"$ref": "#/$defs/endpoint"}]},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["value_id", "src_op_id", "dst_op_id", "relation"], "properties": {"value_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "src_op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "dst_op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "relation": {"$ref": "#/$defs/relation"}}},
    "barrier": {"type": "object", "additionalProperties": false, "required": ["barrier_id", "src_loop_id", "dst_loop_id"], "properties": {"barrier_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "src_loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "dst_loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}}
  }
}
