{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilefoundry-costmodel/result-v2",
  "title": "TileFoundry cost-model result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "plan", "missing_profiles", "rejected_candidates", "diagnostics"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["optimal", "feasible", "timeout", "infeasible", "unsupported", "missing_profile", "profile_failed"]},
    "plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/plan"}]},
    "missing_profiles": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}},
    "rejected_candidates": {"type": "array", "items": {"$ref": "#/$defs/rejected"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["optimal", "feasible"]}}},
      "then": {"properties": {"plan": {"$ref": "#/$defs/plan"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["infeasible", "unsupported", "missing_profile", "profile_failed"]}}},
      "then": {"properties": {"plan": {"type": "null"}}}
    }
  ],
  "$defs": {
    "diagnosticCode": {"enum": ["invalid_candidate", "static_capacity", "missing_profile", "profile_failed", "unsupported", "infeasible", "timeout"]},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/diagnosticCode"}, "message": {"type": "string", "minLength": 1}, "subject_id": {"type": ["string", "null"], "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}},
    "rejected": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"configuration_id": {"type": ["string", "null"], "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "code": {"$ref": "#/$defs/diagnosticCode"}, "message": {"type": "string", "minLength": 1}}},
    "loopTiming": {"type": "object", "additionalProperties": false, "required": ["loop_id", "prologue_ps", "epilogue_ps", "span_ps"], "properties": {"loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "initiation_interval_ps": {"type": ["integer", "null"], "exclusiveMinimum": 0}, "prologue_ps": {"type": "integer", "minimum": 0}, "epilogue_ps": {"type": "integer", "minimum": 0}, "span_ps": {"type": "integer", "minimum": 0}}},
    "reservation": {"type": "object", "additionalProperties": false, "required": ["resource_id", "slots"], "properties": {"resource_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "slots": {"type": "integer", "minimum": 1}}},
    "placement": {"type": "object", "additionalProperties": false, "required": ["phase_id", "source_op_id", "loop_id", "region", "iteration", "start_ps", "end_ps", "warp_ids", "resources"], "properties": {"phase_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "source_op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "loop_id": {"type": ["string", "null"], "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "region": {"enum": ["finite", "prologue", "steady", "epilogue"]}, "iteration": {"type": "integer"}, "start_ps": {"type": "integer", "minimum": 0}, "end_ps": {"type": "integer", "minimum": 0}, "warp_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "resources": {"type": "array", "items": {"$ref": "#/$defs/reservation"}}}},
    "buffer": {"type": "object", "additionalProperties": false, "required": ["buffer_id", "value_id", "storage_resource_id", "bytes_per_slot", "slot_count", "total_bytes"], "properties": {"buffer_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "value_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "storage_resource_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "bytes_per_slot": {"type": "integer", "minimum": 1}, "slot_count": {"type": "integer", "minimum": 1}, "total_bytes": {"type": "integer", "minimum": 1}}},
    "utilization": {"type": "object", "additionalProperties": false, "required": ["resource_id", "capacity_slots", "busy_slot_ps", "horizon_ps"], "properties": {"resource_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "capacity_slots": {"type": "integer", "minimum": 1}, "busy_slot_ps": {"type": "integer", "minimum": 0}, "horizon_ps": {"type": "integer", "minimum": 0}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["phase_id", "source_op_id", "implementation_id", "phase_name", "component_id", "measurement_id", "profile_key_id", "environment_id", "timing_metric", "statistic", "sensitivity_statistic"], "properties": {"phase_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "source_op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "implementation_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "phase_name": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "component_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "measurement_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "profile_key_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "environment_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "timing_metric": {"enum": ["latency", "initiation_interval"]}, "statistic": {"enum": ["p50", "p90"]}, "sensitivity_statistic": {"enum": ["p50", "p90"]}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["status", "objective_ps", "lower_bound_ps", "sensitivity_ps", "optimality_gap_ppm", "solver_name", "solver_version", "candidate_count", "solved_candidate_count", "rejected_candidate_count"], "properties": {"status": {"enum": ["optimal", "feasible", "timeout", "infeasible", "unsupported", "missing_profile", "profile_failed"]}, "objective_ps": {"type": "integer", "minimum": 0}, "lower_bound_ps": {"type": "integer", "minimum": 0}, "sensitivity_ps": {"type": "integer", "minimum": 0}, "optimality_gap_ppm": {"type": "integer", "minimum": 0}, "solver_name": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "solver_version": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "candidate_count": {"type": "integer", "minimum": 0}, "solved_candidate_count": {"type": "integer", "minimum": 0}, "rejected_candidate_count": {"type": "integer", "minimum": 0}}},
    "hardwareRef": {"type": "object", "additionalProperties": false, "required": ["hardware_id", "schema_version", "calibration_id"], "properties": {"hardware_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "schema_version": {"const": 1}, "calibration_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}},
    "snapshotRef": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "revision"], "properties": {"snapshot_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "revision": {"type": "integer", "minimum": 1}}},
    "dtype": {"enum": ["bf16", "fp16", "fp32", "fp8_e4m3", "fp8_e5m2"]},
    "layout": {"enum": ["row_major", "column_major"]},
    "dimension": {"type": "integer", "minimum": 1},
    "gemmWorkload": {"type": "object", "additionalProperties": false, "required": ["kind", "m", "n", "k", "dtype_a", "dtype_b", "dtype_accumulator", "dtype_output", "layout_a", "layout_b"], "properties": {"kind": {"const": "gemm"}, "m": {"$ref": "#/$defs/dimension"}, "n": {"$ref": "#/$defs/dimension"}, "k": {"$ref": "#/$defs/dimension"}, "dtype_a": {"$ref": "#/$defs/dtype"}, "dtype_b": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}, "layout_a": {"$ref": "#/$defs/layout"}, "layout_b": {"$ref": "#/$defs/layout"}, "epilogue": {"enum": ["none", "bias", "relu", "gelu", "silu"]}}},
    "gqaWorkload": {"type": "object", "additionalProperties": false, "required": ["kind", "batch_size", "query_heads", "kv_heads", "head_dim", "context_len", "dtype_query", "dtype_kv", "dtype_accumulator", "dtype_output"], "properties": {"kind": {"const": "gqa_decode"}, "batch_size": {"$ref": "#/$defs/dimension"}, "query_heads": {"$ref": "#/$defs/dimension"}, "kv_heads": {"$ref": "#/$defs/dimension"}, "head_dim": {"$ref": "#/$defs/dimension"}, "context_len": {"$ref": "#/$defs/dimension"}, "dtype_query": {"$ref": "#/$defs/dtype"}, "dtype_kv": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}}},
    "flashWorkload": {"type": "object", "additionalProperties": false, "required": ["kind", "batch_size", "heads", "query_len", "key_len", "head_dim", "dtype_query", "dtype_kv", "dtype_accumulator", "dtype_output", "causal"], "properties": {"kind": {"const": "flash_attention"}, "batch_size": {"$ref": "#/$defs/dimension"}, "heads": {"$ref": "#/$defs/dimension"}, "query_len": {"$ref": "#/$defs/dimension"}, "key_len": {"$ref": "#/$defs/dimension"}, "head_dim": {"$ref": "#/$defs/dimension"}, "dtype_query": {"$ref": "#/$defs/dtype"}, "dtype_kv": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}, "causal": {"type": "boolean"}}},
    "mlpWorkload": {"type": "object", "additionalProperties": false, "required": ["kind", "rows", "input_dim", "hidden_dim", "output_dim", "dtype_input", "dtype_weight", "dtype_accumulator", "dtype_output", "activation"], "properties": {"kind": {"const": "mlp"}, "rows": {"$ref": "#/$defs/dimension"}, "input_dim": {"$ref": "#/$defs/dimension"}, "hidden_dim": {"$ref": "#/$defs/dimension"}, "output_dim": {"$ref": "#/$defs/dimension"}, "dtype_input": {"$ref": "#/$defs/dtype"}, "dtype_weight": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}, "activation": {"enum": ["relu", "gelu", "silu", "swiglu"]}}},
    "workload": {"oneOf": [{"$ref": "#/$defs/gemmWorkload"}, {"$ref": "#/$defs/gqaWorkload"}, {"$ref": "#/$defs/flashWorkload"}, {"$ref": "#/$defs/mlpWorkload"}]},
    "axis": {"type": "object", "additionalProperties": false, "required": ["name", "extent"], "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "extent": {"type": "integer", "minimum": 1}}},
    "shape": {"type": "object", "additionalProperties": false, "required": ["axes"], "properties": {"axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}}}},
    "tensor": {"type": "object", "additionalProperties": false, "required": ["shape", "dtype", "layout"], "properties": {"shape": {"$ref": "#/$defs/shape"}, "dtype": {"$ref": "#/$defs/dtype"}, "layout": {"$ref": "#/$defs/layout"}, "strides_elements": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}}}},
    "programValue": {"type": "object", "additionalProperties": false, "required": ["value_id", "value_type"], "properties": {"value_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "value_type": {"type": "object", "additionalProperties": false, "required": ["tensor", "memory_space"], "properties": {"tensor": {"$ref": "#/$defs/tensor"}, "memory_space": {"enum": ["global", "shared", "tensor", "register"]}}}}},
    "programLoop": {"type": "object", "additionalProperties": false, "required": ["loop_id", "iterations"], "properties": {"loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "iterations": {"type": "integer", "minimum": 1}}},
    "programDomain": {"type": "object", "additionalProperties": false, "required": ["loop_id", "first_iteration", "iteration_count"], "properties": {"loop_id": {"type": ["string", "null"], "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "first_iteration": {"type": "integer", "minimum": 0}, "iteration_count": {"type": "integer", "minimum": 1}}},
    "copyOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "source", "destination", "domain"], "properties": {"kind": {"const": "copy"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "source": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "destination": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "domain": {"$ref": "#/$defs/programDomain"}}},
    "gemmOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "lhs", "rhs", "accumulator", "result", "m_axis", "n_axis", "k_axis", "domain"], "properties": {"kind": {"const": "gemm"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "lhs": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "rhs": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "accumulator": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "result": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "m_axis": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "n_axis": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "k_axis": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "domain": {"$ref": "#/$defs/programDomain"}}},
    "reduceOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "source", "result", "axes", "reduction", "domain"], "properties": {"kind": {"const": "reduce"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "source": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "result": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}, "reduction": {"enum": ["sum", "max"]}, "domain": {"$ref": "#/$defs/programDomain"}}},
    "elementwiseOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "inputs", "result", "function", "domain"], "properties": {"kind": {"const": "elementwise"}, "op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}, "result": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "function": {"enum": ["add", "multiply", "divide", "exp", "relu", "gelu", "silu", "causal_mask"]}, "domain": {"$ref": "#/$defs/programDomain"}}},
    "programOperation": {"oneOf": [{"$ref": "#/$defs/copyOperation"}, {"$ref": "#/$defs/gemmOperation"}, {"$ref": "#/$defs/reduceOperation"}, {"$ref": "#/$defs/elementwiseOperation"}]},
    "alignedRelation": {"type": "object", "additionalProperties": false, "required": ["kind", "iteration_distance"], "properties": {"kind": {"const": "aligned"}, "iteration_distance": {"type": "integer", "minimum": 0}}},
    "endpointRelation": {"type": "object", "additionalProperties": false, "required": ["kind", "src_endpoint", "dst_endpoint"], "properties": {"kind": {"const": "endpoint"}, "src_endpoint": {"enum": ["first", "last"]}, "dst_endpoint": {"enum": ["first", "last"]}}},
    "programRelation": {"oneOf": [{"$ref": "#/$defs/alignedRelation"}, {"$ref": "#/$defs/endpointRelation"}]},
    "programDependency": {"type": "object", "additionalProperties": false, "required": ["value_id", "src_op_id", "dst_op_id", "relation"], "properties": {"value_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "src_op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "dst_op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "relation": {"$ref": "#/$defs/programRelation"}}},
    "programBarrier": {"type": "object", "additionalProperties": false, "required": ["barrier_id", "src_loop_id", "dst_loop_id"], "properties": {"barrier_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "src_loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "dst_loop_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}},
    "tile": {"type": "object", "additionalProperties": false, "required": ["tile_id", "shape"], "properties": {"tile_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "shape": {"$ref": "#/$defs/shape"}}},
    "program": {"type": "object", "additionalProperties": false, "required": ["schema_version", "program_id", "workload_kind", "tile", "values", "loops", "operations", "dependencies", "loop_barriers", "inputs", "outputs"], "properties": {"schema_version": {"const": 2}, "program_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "workload_kind": {"enum": ["gemm", "gqa_decode", "flash_attention", "mlp"]}, "tile": {"$ref": "#/$defs/tile"}, "values": {"type": "array", "items": {"$ref": "#/$defs/programValue"}}, "loops": {"type": "array", "items": {"$ref": "#/$defs/programLoop"}}, "operations": {"type": "array", "items": {"$ref": "#/$defs/programOperation"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/programDependency"}}, "loop_barriers": {"type": "array", "items": {"$ref": "#/$defs/programBarrier"}}, "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}, "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["op_id", "implementation_id"], "properties": {"op_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "implementation_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}}},
    "warpAssignment": {"type": "object", "additionalProperties": false, "required": ["role", "warp_ids"], "properties": {"role": {"enum": ["tma_producer", "tensor_consumer", "cuda_epilogue"]}, "warp_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}},
    "warpConfig": {"type": "object", "additionalProperties": false, "required": ["config_id", "total_warps", "roles"], "properties": {"config_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "total_warps": {"type": "integer", "minimum": 1}, "roles": {"type": "array", "items": {"$ref": "#/$defs/warpAssignment"}, "allOf": [{"contains": {"properties": {"role": {"const": "tma_producer"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"role": {"const": "tensor_consumer"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"role": {"const": "cuda_epilogue"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}]}}},
    "staticDemand": {"type": "object", "additionalProperties": false, "required": ["resource_id", "units"], "properties": {"resource_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "units": {"type": "integer", "minimum": 1}}},
    "selected": {"type": "object", "additionalProperties": false, "required": ["configuration_id", "program_id", "tile", "implementations", "warps", "pipeline_depth", "layout_variant_id", "static_demands"], "properties": {"configuration_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "program_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "tile": {"$ref": "#/$defs/tile"}, "implementations": {"type": "array", "items": {"$ref": "#/$defs/implementation"}}, "warps": {"$ref": "#/$defs/warpConfig"}, "pipeline_depth": {"type": "integer", "minimum": 1}, "layout_variant_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "static_demands": {"type": "array", "items": {"$ref": "#/$defs/staticDemand"}}}},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "hardware", "profile_snapshot", "workload", "program", "selected", "end_to_end_ps", "loop_timings", "placements", "buffers", "utilization", "profiles", "proof"],
      "properties": {"schema_version": {"const": 2}, "request_id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "hardware": {"$ref": "#/$defs/hardwareRef"}, "profile_snapshot": {"$ref": "#/$defs/snapshotRef"}, "workload": {"$ref": "#/$defs/workload"}, "program": {"$ref": "#/$defs/program"}, "selected": {"$ref": "#/$defs/selected"}, "end_to_end_ps": {"type": "integer", "minimum": 0}, "loop_timings": {"type": "array", "items": {"$ref": "#/$defs/loopTiming"}}, "placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}}, "buffers": {"type": "array", "items": {"$ref": "#/$defs/buffer"}}, "utilization": {"type": "array", "items": {"$ref": "#/$defs/utilization"}}, "profiles": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}, "proof": {"$ref": "#/$defs/proof"}}
    }
  }
}
