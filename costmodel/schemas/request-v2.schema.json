{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilefoundry-costmodel/request-v2",
  "title": "TileFoundry cost-model request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "workload", "programs", "hardware", "search_space", "profiles"],
  "properties": {
    "schema_version": {"const": 2},
    "request_id": {"$ref": "#/$defs/id"},
    "workload": {"oneOf": [{"$ref": "#/$defs/gemm"}, {"$ref": "#/$defs/gqa"}, {"$ref": "#/$defs/flash"}, {"$ref": "#/$defs/mlp"}]},
    "programs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/program"}},
    "hardware": {"$ref": "#/$defs/hardwareRef"},
    "search_space": {"$ref": "#/$defs/searchSpace"},
    "profiles": {"$ref": "#/$defs/profiles"},
    "solver": {"$ref": "#/$defs/solver"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"},
    "dtype": {"enum": ["bf16", "fp16", "fp32", "fp8_e4m3", "fp8_e5m2"]},
    "layout": {"enum": ["row_major", "column_major"]},
    "hardwareRef": {
      "type": "object", "additionalProperties": false,
      "required": ["hardware_id", "schema_version", "calibration_id"],
      "properties": {"hardware_id": {"$ref": "#/$defs/id"}, "schema_version": {"const": 1}, "calibration_id": {"$ref": "#/$defs/id"}}
    },
    "axis": {"type": "object", "additionalProperties": false, "required": ["name", "extent"], "properties": {"name": {"$ref": "#/$defs/id"}, "extent": {"type": "integer", "minimum": 1}}},
    "shape": {"type": "object", "additionalProperties": false, "required": ["axes"], "properties": {"axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}}}},
    "tensor": {"type": "object", "additionalProperties": false, "required": ["shape", "dtype", "layout"], "properties": {"shape": {"$ref": "#/$defs/shape"}, "dtype": {"$ref": "#/$defs/dtype"}, "layout": {"$ref": "#/$defs/layout"}, "strides_elements": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}}}},
    "valueType": {"type": "object", "additionalProperties": false, "required": ["tensor", "memory_space"], "properties": {"tensor": {"$ref": "#/$defs/tensor"}, "memory_space": {"enum": ["global", "shared", "tensor", "register"]}}},
    "value": {"type": "object", "additionalProperties": false, "required": ["value_id", "value_type"], "properties": {"value_id": {"$ref": "#/$defs/id"}, "value_type": {"$ref": "#/$defs/valueType"}}},
    "loop": {"type": "object", "additionalProperties": false, "required": ["loop_id", "iterations"], "properties": {"loop_id": {"$ref": "#/$defs/id"}, "iterations": {"type": "integer", "minimum": 1}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["loop_id", "first_iteration", "iteration_count"], "properties": {"loop_id": {"type": ["string", "null"], "minLength": 1, "pattern": "^[\\u0000-\\u007F]+$"}, "first_iteration": {"type": "integer", "minimum": 0}, "iteration_count": {"type": "integer", "minimum": 1}}},
    "copyOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "source", "destination", "domain"], "properties": {"kind": {"const": "copy"}, "op_id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "destination": {"$ref": "#/$defs/id"}, "domain": {"$ref": "#/$defs/domain"}}},
    "gemmOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "lhs", "rhs", "accumulator", "result", "m_axis", "n_axis", "k_axis", "domain"], "properties": {"kind": {"const": "gemm"}, "op_id": {"$ref": "#/$defs/id"}, "lhs": {"$ref": "#/$defs/id"}, "rhs": {"$ref": "#/$defs/id"}, "accumulator": {"$ref": "#/$defs/id"}, "result": {"$ref": "#/$defs/id"}, "m_axis": {"$ref": "#/$defs/id"}, "n_axis": {"$ref": "#/$defs/id"}, "k_axis": {"$ref": "#/$defs/id"}, "domain": {"$ref": "#/$defs/domain"}}},
    "reduceOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "source", "result", "axes", "reduction", "domain"], "properties": {"kind": {"const": "reduce"}, "op_id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "result": {"$ref": "#/$defs/id"}, "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "reduction": {"enum": ["sum", "max"]}, "domain": {"$ref": "#/$defs/domain"}}},
    "elementwiseOperation": {"type": "object", "additionalProperties": false, "required": ["kind", "op_id", "inputs", "result", "function", "domain"], "properties": {"kind": {"const": "elementwise"}, "op_id": {"$ref": "#/$defs/id"}, "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "result": {"$ref": "#/$defs/id"}, "function": {"enum": ["add", "multiply", "divide", "exp", "relu", "gelu", "silu", "causal_mask"]}, "domain": {"$ref": "#/$defs/domain"}}},
    "operation": {"oneOf": [{"$ref": "#/$defs/copyOperation"}, {"$ref": "#/$defs/gemmOperation"}, {"$ref": "#/$defs/reduceOperation"}, {"$ref": "#/$defs/elementwiseOperation"}]},
    "alignedRelation": {"type": "object", "additionalProperties": false, "required": ["kind", "iteration_distance"], "properties": {"kind": {"const": "aligned"}, "iteration_distance": {"type": "integer", "minimum": 0}}},
    "endpointRelation": {"type": "object", "additionalProperties": false, "required": ["kind", "src_endpoint", "dst_endpoint"], "properties": {"kind": {"const": "endpoint"}, "src_endpoint": {"enum": ["first", "last"]}, "dst_endpoint": {"enum": ["first", "last"]}}},
    "relation": {"oneOf": [{"$ref": "#/$defs/alignedRelation"}, {"$ref": "#/$defs/endpointRelation"}]},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["value_id", "src_op_id", "dst_op_id", "relation"], "properties": {"value_id": {"$ref": "#/$defs/id"}, "src_op_id": {"$ref": "#/$defs/id"}, "dst_op_id": {"$ref": "#/$defs/id"}, "relation": {"$ref": "#/$defs/relation"}}},
    "barrier": {"type": "object", "additionalProperties": false, "required": ["barrier_id", "src_loop_id", "dst_loop_id"], "properties": {"barrier_id": {"$ref": "#/$defs/id"}, "src_loop_id": {"$ref": "#/$defs/id"}, "dst_loop_id": {"$ref": "#/$defs/id"}}},
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "program_id", "workload_kind", "tile", "values", "loops", "operations", "dependencies", "loop_barriers", "inputs", "outputs"],
      "properties": {"schema_version": {"const": 2}, "program_id": {"$ref": "#/$defs/id"}, "workload_kind": {"enum": ["gemm", "gqa_decode", "flash_attention", "mlp"]}, "tile": {"type": "object", "additionalProperties": false, "required": ["tile_id", "shape"], "properties": {"tile_id": {"$ref": "#/$defs/id"}, "shape": {"$ref": "#/$defs/shape"}}}, "values": {"type": "array", "items": {"$ref": "#/$defs/value"}}, "loops": {"type": "array", "items": {"$ref": "#/$defs/loop"}}, "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "loop_barriers": {"type": "array", "items": {"$ref": "#/$defs/barrier"}}, "inputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "warpAssignment": {"type": "object", "additionalProperties": false, "required": ["role", "warp_ids"], "properties": {"role": {"enum": ["tma_producer", "tensor_consumer", "cuda_epilogue"]}, "warp_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}},
    "warpConfig": {"type": "object", "additionalProperties": false, "required": ["config_id", "total_warps", "roles"], "properties": {"config_id": {"$ref": "#/$defs/id"}, "total_warps": {"type": "integer", "minimum": 1}, "roles": {"type": "array", "items": {"$ref": "#/$defs/warpAssignment"}, "allOf": [{"contains": {"properties": {"role": {"const": "tma_producer"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"role": {"const": "tensor_consumer"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"role": {"const": "cuda_epilogue"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}]}}},
    "searchSpace": {
      "type": "object", "additionalProperties": false, "required": ["implementation_ids", "warp_configs", "pipeline_depths"],
      "properties": {"implementation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "warp_configs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/warpConfig"}}, "pipeline_depths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 8}}, "layout_variant_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "max_candidates": {"type": "integer", "minimum": 1}}
    },
    "profiles": {"type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": {"snapshot": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "revision"], "properties": {"snapshot_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}}}, "mode": {"enum": ["require", "jit_on_miss"]}, "timing_statistic": {"enum": ["p50", "p90"]}}},
    "solver": {"type": "object", "additionalProperties": false, "properties": {"candidate_timeout_s": {"type": ["number", "null"], "exclusiveMinimum": 0}, "search_timeout_s": {"type": ["number", "null"], "exclusiveMinimum": 0}, "time_resolution_ps": {"type": "integer", "minimum": 1}, "ortools_workers": {"type": "integer", "minimum": 1}, "candidate_workers": {"type": "integer", "minimum": 1}, "random_seed": {"type": "integer"}, "finite_unroll_limit": {"type": "integer", "minimum": 1}, "stop_after_first_solution": {"type": "boolean"}, "deterministic": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"deterministic": {"const": true}}}, "then": {"properties": {"ortools_workers": {"const": 1}, "candidate_workers": {"const": 1}, "stop_after_first_solution": {"const": false}}}}]},
    "dimensions": {"type": "integer", "minimum": 1},
    "workloadDtypes": {"type": "string"},
    "gemm": {"type": "object", "additionalProperties": false, "required": ["kind", "m", "n", "k", "dtype_a", "dtype_b", "dtype_accumulator", "dtype_output", "layout_a", "layout_b"], "properties": {"kind": {"const": "gemm"}, "m": {"$ref": "#/$defs/dimensions"}, "n": {"$ref": "#/$defs/dimensions"}, "k": {"$ref": "#/$defs/dimensions"}, "dtype_a": {"$ref": "#/$defs/dtype"}, "dtype_b": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}, "layout_a": {"$ref": "#/$defs/layout"}, "layout_b": {"$ref": "#/$defs/layout"}, "epilogue": {"enum": ["none", "bias", "relu", "gelu", "silu"]}}},
    "gqa": {"type": "object", "additionalProperties": false, "required": ["kind", "batch_size", "query_heads", "kv_heads", "head_dim", "context_len", "dtype_query", "dtype_kv", "dtype_accumulator", "dtype_output"], "properties": {"kind": {"const": "gqa_decode"}, "batch_size": {"$ref": "#/$defs/dimensions"}, "query_heads": {"$ref": "#/$defs/dimensions"}, "kv_heads": {"$ref": "#/$defs/dimensions"}, "head_dim": {"$ref": "#/$defs/dimensions"}, "context_len": {"$ref": "#/$defs/dimensions"}, "dtype_query": {"$ref": "#/$defs/dtype"}, "dtype_kv": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}}},
    "flash": {"type": "object", "additionalProperties": false, "required": ["kind", "batch_size", "heads", "query_len", "key_len", "head_dim", "dtype_query", "dtype_kv", "dtype_accumulator", "dtype_output", "causal"], "properties": {"kind": {"const": "flash_attention"}, "batch_size": {"$ref": "#/$defs/dimensions"}, "heads": {"$ref": "#/$defs/dimensions"}, "query_len": {"$ref": "#/$defs/dimensions"}, "key_len": {"$ref": "#/$defs/dimensions"}, "head_dim": {"$ref": "#/$defs/dimensions"}, "dtype_query": {"$ref": "#/$defs/dtype"}, "dtype_kv": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}, "causal": {"type": "boolean"}}},
    "mlp": {"type": "object", "additionalProperties": false, "required": ["kind", "rows", "input_dim", "hidden_dim", "output_dim", "dtype_input", "dtype_weight", "dtype_accumulator", "dtype_output", "activation"], "properties": {"kind": {"const": "mlp"}, "rows": {"$ref": "#/$defs/dimensions"}, "input_dim": {"$ref": "#/$defs/dimensions"}, "hidden_dim": {"$ref": "#/$defs/dimensions"}, "output_dim": {"$ref": "#/$defs/dimensions"}, "dtype_input": {"$ref": "#/$defs/dtype"}, "dtype_weight": {"$ref": "#/$defs/dtype"}, "dtype_accumulator": {"$ref": "#/$defs/dtype"}, "dtype_output": {"$ref": "#/$defs/dtype"}, "activation": {"enum": ["relu", "gelu", "silu", "swiglu"]}}}
  }
}
