{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilefoundry.dev/schemas/warpgroup-schedule.schema.json",
  "title": "TileFoundry Warpgroup Schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "lanes", "sync", "times"],
  "properties": {
    "format": {"const": "tilefoundry.warpgroup_schedule"},
    "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane"}},
    "sync": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["after", "before", "distance"], "properties": {"after": {"$ref": "#/$defs/id"}, "before": {"$ref": "#/$defs/id"}, "distance": {"$ref": "#/$defs/nonNegativeInteger"}}}},
    "times": {"type": "array", "items": {"type": "array", "prefixItems": [{"$ref": "#/$defs/nonNegativeInteger"}, {"$ref": "#/$defs/id"}, {"$ref": "#/$defs/nonNegativeInteger"}, {"$ref": "#/$defs/positiveInteger"}, {"$ref": "#/$defs/positiveInteger"}], "items": false, "minItems": 5, "maxItems": 5}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$", "not": {"pattern": "[\\r\\n]"}},
    "operationList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lane": {"oneOf": [{"$ref": "#/$defs/operationList"}, {"type": "object", "additionalProperties": false, "required": ["operations"], "properties": {"operations": {"$ref": "#/$defs/operationList"}, "prologue": {"$ref": "#/$defs/operationList"}, "epilogue": {"$ref": "#/$defs/operationList"}}}]},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0}
  }
}
