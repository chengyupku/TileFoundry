{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilefoundry.dev/schemas/warpgroup-hardware.schema.json",
  "title": "TileFoundry Warpgroup Hardware",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "time_unit", "resources", "costs"],
  "properties": {
    "format": {"const": "tilefoundry.warpgroup_hardware"},
    "time_unit": {"$ref": "#/$defs/id"},
    "resources": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/positiveInteger"}},
    "costs": {"type": "array", "items": {"$ref": "#/$defs/cost"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$", "not": {"pattern": "[\\r\\n]"}},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "dtype": {"enum": ["i1", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "fp8_e4m3fn", "fp8_e5m2", "fp16", "bf16", "fp32", "fp64"]},
    "valueType": {"type": "object", "additionalProperties": false, "required": ["shape", "dtype", "space"], "properties": {"shape": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/positiveInteger"}}, "dtype": {"$ref": "#/$defs/dtype"}, "space": {"enum": ["register", "shared", "global"]}}},
    "canonicalExpression": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "number"}, {"$ref": "#/$defs/canonicalExpression"}]}},
    "signatureOutput": {"type": "object", "additionalProperties": false, "required": ["type", "expr"], "properties": {"type": {"$ref": "#/$defs/valueType"}, "expr": {"$ref": "#/$defs/canonicalExpression"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["kind", "operands", "outputs"], "properties": {"kind": {"enum": ["compute", "view", "copy"]}, "operands": {"type": "array", "items": {"$ref": "#/$defs/valueType"}}, "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signatureOutput"}}}},
    "resourceWindow": {"type": "object", "additionalProperties": false, "required": ["resource_id", "amount", "start_offset", "duration"], "properties": {"resource_id": {"$ref": "#/$defs/id"}, "amount": {"$ref": "#/$defs/positiveInteger"}, "start_offset": {"$ref": "#/$defs/nonNegativeInteger"}, "duration": {"$ref": "#/$defs/positiveInteger"}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["signature", "issue_duration", "completion_latency", "resource_windows"], "properties": {"signature": {"$ref": "#/$defs/signature"}, "issue_duration": {"$ref": "#/$defs/positiveInteger"}, "completion_latency": {"$ref": "#/$defs/positiveInteger"}, "resource_windows": {"type": "array", "items": {"$ref": "#/$defs/resourceWindow"}}}}
  }
}
